FINNHUB_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
MARKETAUX_API_KEY=
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Third-party MCP servers the scheduler dials directly (docker-compose.yaml's `scheduler`
# service passes these through as-is) -- no local service is defined for either, so a local
# `docker compose up` run needs real reachable endpoints here or the scheduler will raise
# KeyError: 'TRADINGVIEW_MCP_URL' / 'STOCK_SCANNER_MCP_URL' on startup.
TRADINGVIEW_MCP_URL=
STOCK_SCANNER_MCP_URL=
