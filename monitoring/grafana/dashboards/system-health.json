{
  "uid": "stock-research-system-health",
  "title": "Stock Research Agent — System Health",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["stock-research", "observability"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request latency (p50/p95) by service",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{app}} p50",
          "expr": "histogram_quantile(0.50, sum by (le, app) (rate(http_request_duration_seconds_bucket[5m])))"
        },
        {
          "refId": "B",
          "legendFormat": "{{app}} p95",
          "expr": "histogram_quantile(0.95, sum by (le, app) (rate(http_request_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx error rate by service",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{app}}",
          "expr": "sum by (app) (rate(http_requests_total{status=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Circuit breaker state (0=closed,1=open,2=half_open)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "min": 0, "max": 2 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{server}}", "expr": "circuit_breaker_state" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Scheduler heartbeat age (seconds)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "time() - scheduler_last_tick_timestamp_seconds" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pod restarts (last 1h)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{namespace}}/{{pod}}",
          "expr": "increase(kube_pod_container_status_restarts_total{namespace=~\"dev|prod\"}[1h])"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": []
      }
    ]
  }
}
